AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=rony
ADMIN_PASSWORD=replace-with-a-strong-password
FASHION_ADMIN_USERNAME=founder
FASHION_ADMIN_PASSWORD=rony4505
# bloodlink | fashion
APP_MODE=bloodlink
NEXT_PUBLIC_APP_MODE=bloodlink
NEXT_PUBLIC_SITE_URL=https://bloodlinkbd.org
DATA_DIR=/app/data

# Optional: protect GET/POST /api/cron/notifications (Railway cron / curl)
# CRON_SECRET=replace-with-a-long-random-secret

# Optional Web Push (auto-generated & saved if omitted)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:bdbloodlink@gmail.com

# Required for donor registration — Gmail OTP only (never shown on website)
RESEND_API_KEY=
# Prefer PLAIN email only (Railway often breaks Name <email> angle brackets).
# Optional display name via OTP_FROM_NAME (e.g. Noorzaa or BloodLink BD).
OTP_FROM_EMAIL=bdbloodlink@gmail.com
# OTP_FROM_NAME=Noorzaa
# Admin forgot username/password OTP destination (default bdbloodlink@gmail.com)
# ADMIN_RECOVERY_EMAIL=bdbloodlink@gmail.com
# Optional alternate email relay:
# SMTP_WEBHOOK_URL=

# Optional SMS (not used for donor register verify)
# SMS_NET_BD_API_KEY=
# SMS_NET_BD_SENDER_ID=
# SMS_WEBHOOK_URL=
# ALLOW_INLINE_OTP=false

# Play Store Trusted Web Activity (Digital Asset Links)
# TWA_PACKAGE_NAME=org.bloodlinkbd.app
# TWA_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...
