# Smart craft corner only — use this Dockerfile path in Railway service settings.
# BloodLink service keeps using the root Dockerfile.

FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--max-old-space-size=4096"
ENV DATA_DIR=/tmp/fashion-build
ENV APP_MODE=fashion
ENV NEXT_PUBLIC_APP_MODE=fashion
ENV NEXT_PUBLIC_SITE_URL=https://smartcraftcorner.up.railway.app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build && test -d .next/standalone

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV DATA_DIR=/app/data
ENV APP_MODE=fashion
ENV NEXT_PUBLIC_APP_MODE=fashion
ENV NEXT_PUBLIC_SITE_URL=https://smartcraftcorner.up.railway.app

RUN apk add --no-cache su-exec \
  && addgroup -S nodejs && adduser -S nextjs -G nodejs \
  && mkdir -p /app/data && chown -R nextjs:nodejs /app

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/package.json ./package.json
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

USER root
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["/app/docker-entrypoint.sh"]
